# ==============================================================================
# Estágio base de build (.NET SDK)
# ==============================================================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["Branchstorm API/BranchstormApiClient/BranchstormApiClient.csproj", "Branchstorm API/BranchstormApiClient/"]
COPY ["FeedbackApi/FeedbackApi.slnx", "FeedbackApi/"]
COPY ["HypothesisServiceApi/HypothesisServiceApi.slnx", "HypothesisServiceApi/"]
COPY ["IdeaServiceApi/IdeaApi.slnx", "IdeaServiceApi/"]
COPY ["TeamServiceApi/TeamApi.slnx", "TeamServiceApi/"]
COPY ["UserServiceApi/UserApi.slnx", "UserServiceApi/"]

COPY . .

# ==============================================================================
# 1. Branchstorm API (Gateway / Client)
# ==============================================================================
FROM build AS publish-gateway
RUN dotnet publish "Branchstorm API/BranchstormApiClient/BranchstormApiClient.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS gateway
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=10000
EXPOSE 10000
COPY --from=publish-gateway /app/publish .

ENTRYPOINT ["dotnet", "BranchstormApiClient.dll"]

# ==============================================================================
# 2. UserServiceApi
# ==============================================================================
FROM build AS publish-user
RUN dotnet publish "UserServiceApi/UserApi.slnx" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS user-api
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=10000
EXPOSE 10000
COPY --from=publish-user /app/publish .
ENTRYPOINT ["dotnet", "UserServiceApi.dll"]

# ==============================================================================
# 3. TeamServiceApi
# ==============================================================================
FROM build AS publish-team
