<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BffApiClassLibrary</RootNamespace>
  </PropertyGroup>

  <!--
    O BFF nao acessa banco: ele so conversa por HTTP com os microsservicos.
    Por isso basta o framework do ASP.NET Core (HttpClient, DI, Http.Json),
    sem Dapper/SQLite e sem depender do BranchstormDomain.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
